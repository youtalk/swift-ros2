# Imports the upstream Lyrical ros2.repos snapshot. We build only
# --packages-up-to the targets in colcon-defaults.meta; the rest are
# present so build deps (ament_cmake, rosidl generators) resolve.
# Mirrors ROS2_RELEASE_TAG in Scripts/build-ros2-xcframework.sh (the script
# clones that tag directly; keep the two in step).
repositories:
  ros2:
    type: git
    url: https://github.com/ros2/ros2.git
    version: release-lyrical-20260807
