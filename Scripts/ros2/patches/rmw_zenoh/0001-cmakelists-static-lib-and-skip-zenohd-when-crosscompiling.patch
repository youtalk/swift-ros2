+    src/detail/simplified_xxhash3.cpp
+    src/detail/zenoh_config.cpp
+    src/zenohd/main.cpp
+  )
+
+  target_link_libraries(rmw_zenohd
+    PRIVATE
+      ament_index_cpp::ament_index_cpp
+      rcutils::rcutils
+      rcpputils::rcpputils
+      rmw::rmw
+      zenohcxx::zenohc
+  )
+
+  install(
+    TARGETS rmw_zenohd
